{
  unsigned int versionNumber;
  unsigned int maxSupportedContacts;
  enum LEGACY_TOUCHPAD_FEATURES legacyTouchpadFeatures;
  struct /* bitfield */
  {
    int touchpadPresent : 1; /* bit position: 0 */
    int legacyTouchpadPresent : 1; /* bit position: 1 */
    int externalMousePresent : 1; /* bit position: 2 */
    int touchpadEnabled : 1; /* bit position: 3 */
    int touchpadActive : 1; /* bit position: 4 */
    int feedbackSupported : 1; /* bit position: 5 */
    int clickForceSupported : 1; /* bit position: 6 */
    int Reserved1 : 25; /* bit position: 7 */
  }; /* bitfield */
  struct /* bitfield */
  {
    int allowActiveWhenMousePresent : 1; /* bit position: 0 */
    int feedbackEnabled : 1; /* bit position: 1 */
    int tapEnabled : 1; /* bit position: 2 */
    int tapAndDragEnabled : 1; /* bit position: 3 */
    int twoFingerTapEnabled : 1; /* bit position: 4 */
    int rightClickZoneEnabled : 1; /* bit position: 5 */
    int mouseAccelSettingHonored : 1; /* bit position: 6 */
    int panEnabled : 1; /* bit position: 7 */
    int zoomEnabled : 1; /* bit position: 8 */
    int scrollDirectionReversed : 1; /* bit position: 9 */
    int Reserved2 : 22; /* bit position: 10 */
  }; /* bitfield */
  enum TOUCHPAD_SENSITIVITY_LEVEL sensitivityLevel;
  unsigned int cursorSpeed;
  unsigned int feedbackIntensity;
  unsigned int clickForceSensitivity;
  unsigned int rightClickZoneWidth;
  unsigned int rightClickZoneHeight;
};

