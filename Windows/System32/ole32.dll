typedef struct _TRIPLE_LIST
{
  union
  {
    struct
    {
      struct /* bitfield */
      {
        volatile unsigned long SwitchSelectorBit0 : 1; /* bit position: 0 */
        volatile unsigned long ActiveListBit0 : 1; /* bit position: 1 */
        volatile unsigned long OverflowActiveListBit0 : 1; /* bit position: 2 */
        volatile unsigned long SwitchSelectorBit1 : 1; /* bit position: 3 */
        volatile unsigned long ActiveListBit1 : 1; /* bit position: 4 */
        volatile unsigned long OverflowActiveListBit1 : 1; /* bit position: 5 */
        volatile unsigned long ReaderDidTheSwitch : 1; /* bit position: 6 */
        volatile unsigned long Reserved : 22; /* bit position: 7 */
        volatile unsigned long ReaderBusy : 1; /* bit position: 29 */
        volatile unsigned long UpdateReady : 1; /* bit position: 30 */
        volatile unsigned long OverflowUpdateReady : 1; /* bit position: 31 */
      }; /* bitfield */
    } ControlBits;
    volatile long CombinedControlBits;
  };
  struct _TRIPLE_LIST_ENTRY Head;
  struct _TRIPLE_LIST_ENTRY* Tail[3];
  void* RemoveCallback /* function */;
  void* RemoveContext;
  struct _TRIPLE_LIST_ENTRY* PendingHead;
  struct _TRIPLE_LIST_ENTRY** PendingTailPtr;
  unsigned long PendingListIndex;
  long __PADDING__[1];
} TRIPLE_LIST, *PTRIPLE_LIST;

typedef struct _TRIPLE_LIST_ENTRY
{
  struct _TRIPLE_LIST_ENTRY* Flink[3];
  struct _TRIPLE_LIST_ENTRY* Blink;
} TRIPLE_LIST_ENTRY, *PTRIPLE_LIST_ENTRY;

