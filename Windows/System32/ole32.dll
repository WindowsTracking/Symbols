  unsigned char ImageContainsCode;
  union
  {
    unsigned char ImageFlags;
    struct /* bitfield */
    {
      unsigned char ComPlus : 1; /* bit position: 0 */
      unsigned char ImageDynamicallyRelocated : 1; /* bit position: 1 */
      unsigned char Reserved : 6; /* bit position: 2 */
    }; /* bitfield */
  };
  unsigned long LoaderFlags;
  unsigned long ImageFileSize;
  unsigned long CheckSum;
} SECTION_IMAGE_INFORMATION32, *PSECTION_IMAGE_INFORMATION32;

