typedef struct _LDR_DATA_TABLE_ENTRY
{
  struct _LIST_ENTRY InLoadOrderLinks;
  struct _LIST_ENTRY InMemoryOrderLinks;
  struct _LIST_ENTRY InInitializationOrderLinks;
  void* DllBase;
  void* EntryPoint;
  unsigned long SizeOfImage;
  struct _UNICODE_STRING FullDllName;
  struct _UNICODE_STRING BaseDllName;
  union
  {
    unsigned char FlagGroup[4];
    unsigned long Flags;
    struct /* bitfield */
    {
      unsigned long PackagedBinary : 1; /* bit position: 0 */
      unsigned long MarkedForRemoval : 1; /* bit position: 1 */
      unsigned long ImageDll : 1; /* bit position: 2 */
      unsigned long LoadNotificationsSent : 1; /* bit position: 3 */
      unsigned long TelemetryEntryProcessed : 1; /* bit position: 4 */
      unsigned long ProcessStaticImport : 1; /* bit position: 5 */
      unsigned long InLegacyLists : 1; /* bit position: 6 */
      unsigned long InIndexes : 1; /* bit position: 7 */
      unsigned long ShimDll : 1; /* bit position: 8 */
      unsigned long InExceptionTable : 1; /* bit position: 9 */
      unsigned long ReservedFlags1 : 2; /* bit position: 10 */
      unsigned long LoadInProgress : 1; /* bit position: 12 */
      unsigned long LoadConfigProcessed : 1; /* bit position: 13 */
      unsigned long EntryProcessed : 1; /* bit position: 14 */
      unsigned long ProtectDelayLoad : 1; /* bit position: 15 */
      unsigned long ReservedFlags3 : 2; /* bit position: 16 */
      unsigned long DontCallForThreads : 1; /* bit position: 18 */
      unsigned long ProcessAttachCalled : 1; /* bit position: 19 */
      unsigned long ProcessAttachFailed : 1; /* bit position: 20 */
      unsigned long CorDeferredValidate : 1; /* bit position: 21 */
      unsigned long CorImage : 1; /* bit position: 22 */
      unsigned long DontRelocate : 1; /* bit position: 23 */
      unsigned long CorILOnly : 1; /* bit position: 24 */
      unsigned long ReservedFlags5 : 3; /* bit position: 25 */
      unsigned long Redirected : 1; /* bit position: 28 */
      unsigned long ReservedFlags6 : 2; /* bit position: 29 */
      unsigned long CompatDatabaseProcessed : 1; /* bit position: 31 */
    }; /* bitfield */
  };
  unsigned short ObsoleteLoadCount;
  unsigned short TlsIndex;
  struct _LIST_ENTRY HashLinks;
  unsigned long TimeDateStamp;
  struct _ACTIVATION_CONTEXT* EntryPointActivationContext;
  void* Lock;
  struct _LDR_DDAG_NODE* DdagNode;
  struct _LIST_ENTRY NodeModuleLink;
  struct _LDRP_LOAD_CONTEXT* LoadContext;
  void* ParentDllBase;
  void* SwitchBackContext;
  struct _RTL_BALANCED_NODE BaseAddressIndexNode;
  struct _RTL_BALANCED_NODE MappingInfoIndexNode;
  unsigned __int64 OriginalBase;
  union _LARGE_INTEGER LoadTime;
  unsigned long BaseNameHashValue;
  enum _LDR_DLL_LOAD_REASON LoadReason;
  unsigned long ImplicitPathOptions;
  unsigned long ReferenceCount;
  unsigned long DependentLoadFlags;
  unsigned char SigningLevel;
  char __PADDING__[3];
} LDR_DATA_TABLE_ENTRY, *PLDR_DATA_TABLE_ENTRY;

typedef struct _LDR_DATA_TABLE_ENTRY32
{
  struct LIST_ENTRY32 InLoadOrderLinks;
  struct LIST_ENTRY32 InMemoryOrderLinks;
  struct LIST_ENTRY32 InInitializationOrderLinks;
  unsigned long DllBase;
  unsigned long EntryPoint;
  unsigned long SizeOfImage;
  struct _STRING32 FullDllName;
  struct _STRING32 BaseDllName;
  unsigned long Flags;
  unsigned short LoadCount;
  unsigned short TlsIndex;
  union
  {
    struct LIST_ENTRY32 HashLinks;
    struct
    {
      unsigned long SectionPointer;
      unsigned long CheckSum;
    };
  };
  union
  {
    unsigned long TimeDateStamp;
    unsigned long LoadedImports;
  };
} LDR_DATA_TABLE_ENTRY32, *PLDR_DATA_TABLE_ENTRY32;

typedef struct _LDR_DATA_TABLE_ENTRY64
