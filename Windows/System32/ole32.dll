typedef struct _MMPFN_IDENTITY
{
  union
  {
    union
    {
      struct _MEMORY_FRAME_INFORMATION e1;
      struct _FILEOFFSET_INFORMATION e2;
      struct _PAGEDIR_INFORMATION e3;
      struct _UNIQUE_PROCESS_INFORMATION e4;
    };
  } u1;
  unsigned __int64 PageFrameIndex;
  union
  {
    union
    {
      struct
      {
        struct /* bitfield */
        {
          unsigned __int64 Image : 1; /* bit position: 0 */
          unsigned __int64 Mismatch : 1; /* bit position: 1 */
        }; /* bitfield */
      } e1;
      struct
      {
        unsigned __int64 CombinedPage : 1; /* bit position: 0 */
      } e2;
