typedef struct _LDT_ENTRY
{
  unsigned short LimitLow;
  unsigned short BaseLow;
  union
  {
    union
    {
      struct
      {
        unsigned char BaseMid;
        unsigned char Flags1;
        unsigned char Flags2;
        unsigned char BaseHi;
      } Bytes;
      struct
      {
        struct /* bitfield */
        {
          unsigned long BaseMid : 8; /* bit position: 0 */
          unsigned long Type : 5; /* bit position: 8 */
          unsigned long Dpl : 2; /* bit position: 13 */
          unsigned long Pres : 1; /* bit position: 15 */
          unsigned long LimitHi : 4; /* bit position: 16 */
          unsigned long Sys : 1; /* bit position: 20 */
          unsigned long Reserved_0 : 1; /* bit position: 21 */
          unsigned long Default_Big : 1; /* bit position: 22 */
          unsigned long Granularity : 1; /* bit position: 23 */
          unsigned long BaseHi : 8; /* bit position: 24 */
        }; /* bitfield */
      } Bits;
    };
  } HighWord;
} LDT_ENTRY, *PLDT_ENTRY;

