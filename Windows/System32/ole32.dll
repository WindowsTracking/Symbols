      unsigned long SameAttributes : 1; /* bit position: 17 */
      unsigned long Indirect : 1; /* bit position: 18 */
      unsigned long Inherit : 1; /* bit position: 19 */
      unsigned long Reserved1 : 12; /* bit position: 20 */
    }; /* bitfield */
  };
  union
  {
    void* Handle;
    struct _ALPC_HANDLE_ATTR32* HandleAttrArray;
  };
  union
  {
    unsigned long ObjectType;
