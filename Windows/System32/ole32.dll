class CRWLock
{
  union
  {
    struct CRWLock::LockState _lockState;
    volatile unsigned __int64 _ulLockState;
  };
  volatile unsigned long _dwWriterSeqNum;
  volatile unsigned long _dwWriterID;
  unsigned short _wFlags;
  unsigned short _wWriterLevel;
  union
  {
    struct CRWLock::EventState _eventState;
    struct
    {
      volatile unsigned long _dwEventState;
      volatile unsigned long _dwHighPart;
    };
    class EventPoolEntry* volatile _pPoolEntry;
  };
};

struct CRWLock::EventState
{
  struct /* bitfield */
  {
    volatile unsigned long _entryIsEventMask : 1; /* bit position: 0 */
    volatile unsigned long _entryIsMarkedForPooling : 1; /* bit position: 1 */
    volatile unsigned long _entryIsBeingPooled : 1; /* bit position: 2 */
    volatile unsigned long _readerEventBeingSignaled : 1; /* bit position: 3 */
    volatile unsigned long _readerEventBeingReset : 1; /* bit position: 4 */
    volatile unsigned long _readerCountIsSignalCount : 1; /* bit position: 5 */
    volatile unsigned long _readerCount : 25; /* bit position: 6 */
    volatile unsigned long _writerEventSignaled : 1; /* bit position: 31 */
  }; /* bitfield */
};

struct CRWLock::LockState
{
  struct /* bitfield */
  {
    volatile unsigned __int64 _numReaders : 20; /* bit position: 0 */
    volatile unsigned __int64 _writerPresent : 1; /* bit position: 20 */
    volatile unsigned __int64 _writerSignaled : 1; /* bit position: 21 */
    volatile unsigned __int64 _readerSignaled : 1; /* bit position: 22 */
    volatile unsigned __int64 _resetInProgress : 1; /* bit position: 23 */
    volatile unsigned __int64 _waitingReaders : 20; /* bit position: 24 */
    volatile unsigned __int64 _waitingWriters : 20; /* bit position: 44 */
  }; /* bitfield */
};

