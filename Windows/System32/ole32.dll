typedef struct _SECTION_IMAGE_INFORMATION
{
  void* TransferAddress;
  unsigned long ZeroBits;
  unsigned __int64 MaximumStackSize;
  unsigned __int64 CommittedStackSize;
  unsigned long SubSystemType;
  union
  {
    struct
    {
      unsigned short SubSystemMinorVersion;
      unsigned short SubSystemMajorVersion;
    };
    unsigned long SubSystemVersion;
  };
  union
  {
    struct
    {
      unsigned short MajorOperatingSystemVersion;
      unsigned short MinorOperatingSystemVersion;
    };
    unsigned long OperatingSystemVersion;
  };
  unsigned short ImageCharacteristics;
  unsigned short DllCharacteristics;
  unsigned short Machine;
  unsigned char ImageContainsCode;
  union
  {
    unsigned char ImageFlags;
    struct /* bitfield */
    {
      unsigned char ComPlusNativeReady : 1; /* bit position: 0 */
      unsigned char ComPlusILOnly : 1; /* bit position: 1 */
      unsigned char ImageDynamicallyRelocated : 1; /* bit position: 2 */
      unsigned char ImageMappedFlat : 1; /* bit position: 3 */
      unsigned char BaseBelow4gb : 1; /* bit position: 4 */
      unsigned char ComPlusPrefer32bit : 1; /* bit position: 5 */
      unsigned char Reserved : 2; /* bit position: 6 */
    }; /* bitfield */
  };
  unsigned long LoaderFlags;
  unsigned long ImageFileSize;
  unsigned long CheckSum;
} SECTION_IMAGE_INFORMATION, *PSECTION_IMAGE_INFORMATION;

