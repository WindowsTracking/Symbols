class EventPoolEntry
{
  union
  {
    struct CRWLock::EventState _eventState;
    struct
    {
      volatile unsigned long _dwEventState;
      volatile int _bReaderSignaled;
      void* _hReaderEvent;
      struct _SLIST_ENTRY _listEntry;
      void* _hWriterEvent;
      volatile unsigned long _dwSpinningWriterID;
    };
    union _SLIST_HEADER s_eventPool;
    union EventPoolEntry::InitState s_initState;
  };
};

union EventPoolEntry::InitState
{
  union
  {
    volatile unsigned __int64 _ulInitState;
    struct /* bitfield */
    {
      volatile unsigned __int64 _ulNumInitedRWThreads : 24; /* bit position: 0 */
      volatile unsigned __int64 _ulNumInitedRWLocks : 40; /* bit position: 24 */
    }; /* bitfield */
  };
};

