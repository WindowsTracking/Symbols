typedef struct _SYSTEM_POWER_STATE_CONTEXT
{
  union
  {
    struct /* bitfield */
    {
      unsigned long Reserved1 : 8; /* bit position: 0 */
      unsigned long TargetSystemState : 4; /* bit position: 8 */
      unsigned long EffectiveSystemState : 4; /* bit position: 12 */
