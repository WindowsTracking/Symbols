      unsigned __int64 Version : 1; /* bit position: 1 */
      unsigned __int64 CommandStatus : 1; /* bit position: 2 */
      unsigned __int64 DeviceId : 1; /* bit position: 3 */
      unsigned __int64 DeviceSerialNumber : 1; /* bit position: 4 */
      unsigned __int64 BridgeControlStatus : 1; /* bit position: 5 */
      unsigned __int64 ExpressCapability : 1; /* bit position: 6 */
      unsigned __int64 AerInfo : 1; /* bit position: 7 */
      unsigned __int64 Reserved : 56; /* bit position: 8 */
    }; /* bitfield */
    unsigned __int64 ValidBits;
  };
} WHEA_PCIEXPRESS_ERROR_VALIDBITS, *PWHEA_PCIEXPRESS_ERROR_VALIDBITS;

typedef union _WHEA_PCIEXPRESS_VERSION
{
  union
  {
    struct
    {
      unsigned char MinorVersion;
      unsigned char MajorVersion;
      unsigned short Reserved;
    };
    unsigned long AsULONG;
  };
} WHEA_PCIEXPRESS_VERSION, *PWHEA_PCIEXPRESS_VERSION;

typedef union _WHEA_PCIXBUS_COMMAND
{
  union
  {
    struct /* bitfield */
    {
      unsigned __int64 Command : 56; /* bit position: 0 */
      unsigned __int64 PCIXCommand : 1; /* bit position: 56 */
      unsigned __int64 Reserved : 7; /* bit position: 57 */
    }; /* bitfield */
    unsigned __int64 AsULONGLONG;
  };
} WHEA_PCIXBUS_COMMAND, *PWHEA_PCIXBUS_COMMAND;

typedef struct _WHEA_PCIXBUS_ERROR
{
  union _WHEA_PCIXBUS_ERROR_VALIDBITS ValidBits;
  union _WHEA_ERROR_STATUS ErrorStatus;
  unsigned short ErrorType;
  union _WHEA_PCIXBUS_ID BusId;
  unsigned long Reserved;
  unsigned __int64 BusAddress;
  unsigned __int64 BusData;
  union _WHEA_PCIXBUS_COMMAND BusCommand;
  unsigned __int64 RequesterId;
  unsigned __int64 CompleterId;
  unsigned __int64 TargetId;
} WHEA_PCIXBUS_ERROR, *PWHEA_PCIXBUS_ERROR;

typedef union _WHEA_PCIXBUS_ERROR_VALIDBITS
{
  union
  {
    struct /* bitfield */
    {
      unsigned __int64 ErrorStatus : 1; /* bit position: 0 */
      unsigned __int64 ErrorType : 1; /* bit position: 1 */
      unsigned __int64 BusId : 1; /* bit position: 2 */
      unsigned __int64 BusAddress : 1; /* bit position: 3 */
      unsigned __int64 BusData : 1; /* bit position: 4 */
      unsigned __int64 BusCommand : 1; /* bit position: 5 */
      unsigned __int64 RequesterId : 1; /* bit position: 6 */
      unsigned __int64 CompleterId : 1; /* bit position: 7 */
      unsigned __int64 TargetId : 1; /* bit position: 8 */
      unsigned __int64 Reserved : 55; /* bit position: 9 */
    }; /* bitfield */
    unsigned __int64 ValidBits;
  };
} WHEA_PCIXBUS_ERROR_VALIDBITS, *PWHEA_PCIXBUS_ERROR_VALIDBITS;

typedef union _WHEA_PCIXBUS_ID
{
  union
  {
    struct
    {
      unsigned char BusNumber;
      unsigned char BusSegment;
    };
    unsigned short AsUSHORT;
  };
} WHEA_PCIXBUS_ID, *PWHEA_PCIXBUS_ID;

typedef struct _WHEA_PCIXDEVICE_ERROR
{
  union _WHEA_PCIXDEVICE_ERROR_VALIDBITS ValidBits;
  union _WHEA_ERROR_STATUS ErrorStatus;
  struct _WHEA_PCIXDEVICE_ID IdInfo;
  unsigned long MemoryNumber;
  unsigned long IoNumber;
  struct WHEA_PCIXDEVICE_REGISTER_PAIR RegisterDataPairs[4];
} WHEA_PCIXDEVICE_ERROR, *PWHEA_PCIXDEVICE_ERROR;

typedef union _WHEA_PCIXDEVICE_ERROR_VALIDBITS
{
  union
  {
    struct /* bitfield */
    {
      unsigned __int64 ErrorStatus : 1; /* bit position: 0 */
      unsigned __int64 IdInfo : 1; /* bit position: 1 */
      unsigned __int64 MemoryNumber : 1; /* bit position: 2 */
      unsigned __int64 IoNumber : 1; /* bit position: 3 */
      unsigned __int64 RegisterDataPairs : 1; /* bit position: 4 */
      unsigned __int64 Reserved : 59; /* bit position: 5 */
    }; /* bitfield */
    unsigned __int64 ValidBits;
  };
} WHEA_PCIXDEVICE_ERROR_VALIDBITS, *PWHEA_PCIXDEVICE_ERROR_VALIDBITS;

typedef struct _WHEA_PCIXDEVICE_ID
{
  unsigned short VendorId;
  unsigned short DeviceId;
  struct /* bitfield */
  {
    unsigned long ClassCode : 24; /* bit position: 0 */
    unsigned long FunctionNumber : 8; /* bit position: 24 */
  }; /* bitfield */
  struct /* bitfield */
  {
    unsigned long DeviceNumber : 8; /* bit position: 0 */
    unsigned long BusNumber : 8; /* bit position: 8 */
    unsigned long SegmentNumber : 8; /* bit position: 16 */
    unsigned long Reserved1 : 8; /* bit position: 24 */
  }; /* bitfield */
  unsigned long Reserved2;
} WHEA_PCIXDEVICE_ID, *PWHEA_PCIXDEVICE_ID;

struct WHEA_PCIXDEVICE_REGISTER_PAIR
{
  unsigned __int64 Register;
  unsigned __int64 Data;
};

typedef union _WHEA_PERSISTENCE_INFO
{
  union
  {
    struct /* bitfield */
    {
      unsigned __int64 Signature : 16; /* bit position: 0 */
      unsigned __int64 Length : 24; /* bit position: 16 */
      unsigned __int64 Identifier : 16; /* bit position: 40 */
      unsigned __int64 Attributes : 2; /* bit position: 56 */
      unsigned __int64 DoNotLog : 1; /* bit position: 58 */
      unsigned __int64 Reserved : 5; /* bit position: 59 */
    }; /* bitfield */
    unsigned __int64 AsULONGLONG;
  };
} WHEA_PERSISTENCE_INFO, *PWHEA_PERSISTENCE_INFO;

typedef enum _WHEA_RAW_DATA_FORMAT
{
  WheaRawDataFormatIPFSalRecord = 0,
  WheaRawDataFormatIA32MCA = 1,
  WheaRawDataFormatIntel64MCA = 2,
  WheaRawDataFormatAMD64MCA = 3,
  WheaRawDataFormatMemory = 4,
