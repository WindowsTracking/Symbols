    unsigned long RawDeviceOK : 1; /* bit position: 8 */
    unsigned long SurpriseRemovalOK : 1; /* bit position: 9 */
    unsigned long WakeFromD0 : 1; /* bit position: 10 */
    unsigned long WakeFromD1 : 1; /* bit position: 11 */
    unsigned long WakeFromD2 : 1; /* bit position: 12 */
    unsigned long WakeFromD3 : 1; /* bit position: 13 */
    unsigned long HardwareDisabled : 1; /* bit position: 14 */
    unsigned long NonDynamic : 1; /* bit position: 15 */
    unsigned long WarmEjectSupported : 1; /* bit position: 16 */
    unsigned long NoDisplayInUI : 1; /* bit position: 17 */
    unsigned long Reserved1 : 1; /* bit position: 18 */
    unsigned long WakeFromInterrupt : 1; /* bit position: 19 */
    unsigned long Reserved : 12; /* bit position: 20 */
  }; /* bitfield */
  unsigned long Address;
  unsigned long UINumber;
  enum _DEVICE_POWER_STATE DeviceState[7];
  enum _SYSTEM_POWER_STATE SystemWake;
  enum _DEVICE_POWER_STATE DeviceWake;
