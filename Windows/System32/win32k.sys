typedef struct _DISPATCHER_HEADER
{
  union
  {
    struct
    {
      unsigned char Type;
      union
      {
        unsigned char TimerControlFlags;
        struct /* bitfield */
        {
          unsigned char Absolute : 1; /* bit position: 0 */
          unsigned char Coalescable : 1; /* bit position: 1 */
          unsigned char KeepShifting : 1; /* bit position: 2 */
          unsigned char EncodedTolerableDelay : 5; /* bit position: 3 */
        }; /* bitfield */
        unsigned char Abandoned;
        struct
        {
          unsigned char Signalling;
          union
          {
            unsigned char ThreadControlFlags;
            struct /* bitfield */
            {
              unsigned char CpuThrottled : 1; /* bit position: 0 */
              unsigned char CycleProfiling : 1; /* bit position: 1 */
              unsigned char CounterProfiling : 1; /* bit position: 2 */
              unsigned char Reserved : 5; /* bit position: 3 */
            }; /* bitfield */
            unsigned char Hand;
            struct
            {
              unsigned char Size;
              union
              {
                unsigned char TimerMiscFlags;
                struct /* bitfield */
                {
                  unsigned char Index : 6; /* bit position: 0 */
                  unsigned char Inserted : 1; /* bit position: 6 */
                  volatile unsigned char Expired : 1; /* bit position: 7 */
                }; /* bitfield */
                unsigned char DebugActive;
                struct /* bitfield */
                {
                  unsigned char ActiveDR7 : 1; /* bit position: 0 */
                  unsigned char Instrumented : 1; /* bit position: 1 */
                  unsigned char Reserved2 : 4; /* bit position: 2 */
                  unsigned char UmsScheduled : 1; /* bit position: 6 */
                  unsigned char UmsPrimary : 1; /* bit position: 7 */
                }; /* bitfield */
                unsigned char DpcActive;
              };
            };
          };
        };
      };
    };
    volatile long Lock;
  };
  long SignalState;
  struct _LIST_ENTRY WaitListHead;
} DISPATCHER_HEADER, *PDISPATCHER_HEADER;

