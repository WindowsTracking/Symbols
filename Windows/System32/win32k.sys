  unsigned long PshedDataLength;
} WHEA_ERROR_PACKET_V2, *PWHEA_ERROR_PACKET_V2;

typedef struct _WHEA_ERROR_RECORD
{
  struct _WHEA_ERROR_RECORD_HEADER Header;
  struct _WHEA_ERROR_RECORD_SECTION_DESCRIPTOR SectionDescriptor[1];
} WHEA_ERROR_RECORD, *PWHEA_ERROR_RECORD;

typedef struct _WHEA_ERROR_RECORD_HEADER
{
  unsigned long Signature;
  union _WHEA_REVISION Revision;
  unsigned long SignatureEnd;
  unsigned short SectionCount;
  enum _WHEA_ERROR_SEVERITY Severity;
  union _WHEA_ERROR_RECORD_HEADER_VALIDBITS ValidBits;
  unsigned long Length;
  union _WHEA_TIMESTAMP Timestamp;
  struct _GUID PlatformId;
  struct _GUID PartitionId;
  struct _GUID CreatorId;
  struct _GUID NotifyType;
  unsigned __int64 RecordId;
  union _WHEA_ERROR_RECORD_HEADER_FLAGS Flags;
  union _WHEA_PERSISTENCE_INFO PersistenceInfo;
  unsigned char Reserved[12];
} WHEA_ERROR_RECORD_HEADER, *PWHEA_ERROR_RECORD_HEADER;

typedef union _WHEA_ERROR_RECORD_HEADER_FLAGS
{
  union
  {
    struct /* bitfield */
    {
      unsigned long Recovered : 1; /* bit position: 0 */
      unsigned long PreviousError : 1; /* bit position: 1 */
      unsigned long Simulated : 1; /* bit position: 2 */
      unsigned long Reserved : 29; /* bit position: 3 */
    }; /* bitfield */
    unsigned long AsULONG;
  };
} WHEA_ERROR_RECORD_HEADER_FLAGS, *PWHEA_ERROR_RECORD_HEADER_FLAGS;

typedef union _WHEA_ERROR_RECORD_HEADER_VALIDBITS
{
  union
  {
    struct /* bitfield */
    {
      unsigned long PlatformId : 1; /* bit position: 0 */
      unsigned long Timestamp : 1; /* bit position: 1 */
      unsigned long PartitionId : 1; /* bit position: 2 */
      unsigned long Reserved : 29; /* bit position: 3 */
    }; /* bitfield */
    unsigned long AsULONG;
  };
} WHEA_ERROR_RECORD_HEADER_VALIDBITS, *PWHEA_ERROR_RECORD_HEADER_VALIDBITS;

typedef struct _WHEA_ERROR_RECORD_SECTION_DESCRIPTOR
{
  unsigned long SectionOffset;
  unsigned long SectionLength;
  union _WHEA_REVISION Revision;
  union _WHEA_ERROR_RECORD_SECTION_DESCRIPTOR_VALIDBITS ValidBits;
  unsigned char Reserved;
  union _WHEA_ERROR_RECORD_SECTION_DESCRIPTOR_FLAGS Flags;
  struct _GUID SectionType;
  struct _GUID FRUId;
  enum _WHEA_ERROR_SEVERITY SectionSeverity;
  char FRUText[20];
} WHEA_ERROR_RECORD_SECTION_DESCRIPTOR, *PWHEA_ERROR_RECORD_SECTION_DESCRIPTOR;

typedef union _WHEA_ERROR_RECORD_SECTION_DESCRIPTOR_FLAGS
{
  union
  {
    struct /* bitfield */
    {
      unsigned long Primary : 1; /* bit position: 0 */
      unsigned long ContainmentWarning : 1; /* bit position: 1 */
      unsigned long Reset : 1; /* bit position: 2 */
      unsigned long ThresholdExceeded : 1; /* bit position: 3 */
      unsigned long ResourceNotAvailable : 1; /* bit position: 4 */
      unsigned long LatentError : 1; /* bit position: 5 */
      unsigned long Reserved : 26; /* bit position: 6 */
    }; /* bitfield */
    unsigned long AsULONG;
  };
} WHEA_ERROR_RECORD_SECTION_DESCRIPTOR_FLAGS, *PWHEA_ERROR_RECORD_SECTION_DESCRIPTOR_FLAGS;

typedef union _WHEA_ERROR_RECORD_SECTION_DESCRIPTOR_VALIDBITS
{
  union
  {
    struct /* bitfield */
    {
      unsigned char FRUId : 1; /* bit position: 0 */
      unsigned char FRUText : 1; /* bit position: 1 */
      unsigned char Reserved : 6; /* bit position: 2 */
    }; /* bitfield */
    unsigned char AsUCHAR;
  };
} WHEA_ERROR_RECORD_SECTION_DESCRIPTOR_VALIDBITS, *PWHEA_ERROR_RECORD_SECTION_DESCRIPTOR_VALIDBITS;

typedef enum _WHEA_ERROR_SEVERITY
{
  WheaErrSevRecoverable = 0,
  WheaErrSevFatal = 1,
  WheaErrSevCorrected = 2,
  WheaErrSevInformational = 3,
} WHEA_ERROR_SEVERITY, *PWHEA_ERROR_SEVERITY;

typedef enum _WHEA_ERROR_SOURCE_TYPE
{
  WheaErrSrcTypeMCE = 0,
  WheaErrSrcTypeCMC = 1,
  WheaErrSrcTypeCPE = 2,
  WheaErrSrcTypeNMI = 3,
  WheaErrSrcTypePCIe = 4,
  WheaErrSrcTypeGeneric = 5,
  WheaErrSrcTypeINIT = 6,
  WheaErrSrcTypeBOOT = 7,
  WheaErrSrcTypeSCIGeneric = 8,
  WheaErrSrcTypeIPFMCA = 9,
  WheaErrSrcTypeIPFCMC = 10,
  WheaErrSrcTypeIPFCPE = 11,
  WheaErrSrcTypeMax = 12,
} WHEA_ERROR_SOURCE_TYPE, *PWHEA_ERROR_SOURCE_TYPE;

typedef enum _WHEA_ERROR_TYPE
{
  WheaErrTypeProcessor = 0,
  WheaErrTypeMemory = 1,
  WheaErrTypePCIExpress = 2,
  WheaErrTypeNMI = 3,
  WheaErrTypePCIXBus = 4,
  WheaErrTypePCIXDevice = 5,
  WheaErrTypeGeneric = 6,
} WHEA_ERROR_TYPE, *PWHEA_ERROR_TYPE;

typedef union _WHEA_PERSISTENCE_INFO
{
  union
  {
    struct /* bitfield */
    {
      unsigned __int64 Signature : 16; /* bit position: 0 */
      unsigned __int64 Length : 24; /* bit position: 16 */
      unsigned __int64 Identifier : 16; /* bit position: 40 */
      unsigned __int64 Attributes : 2; /* bit position: 56 */
      unsigned __int64 DoNotLog : 1; /* bit position: 58 */
      unsigned __int64 Reserved : 5; /* bit position: 59 */
    }; /* bitfield */
    unsigned __int64 AsULONGLONG;
  };
} WHEA_PERSISTENCE_INFO, *PWHEA_PERSISTENCE_INFO;

typedef union _WHEA_REVISION
{
  union
  {
    struct
    {
      unsigned char MinorRevision;
      unsigned char MajorRevision;
    };
    unsigned short AsUSHORT;
  };
} WHEA_REVISION, *PWHEA_REVISION;

typedef union _WHEA_TIMESTAMP
{
  union
  {
    struct /* bitfield */
    {
      unsigned __int64 Seconds : 8; /* bit position: 0 */
      unsigned __int64 Minutes : 8; /* bit position: 8 */
      unsigned __int64 Hours : 8; /* bit position: 16 */
      unsigned __int64 Precise : 1; /* bit position: 24 */
      unsigned __int64 Reserved : 7; /* bit position: 25 */
      unsigned __int64 Day : 8; /* bit position: 32 */
      unsigned __int64 Month : 8; /* bit position: 40 */
      unsigned __int64 Year : 8; /* bit position: 48 */
      unsigned __int64 Century : 8; /* bit position: 56 */
    }; /* bitfield */
    union _LARGE_INTEGER AsLARGE_INTEGER;
  };
} WHEA_TIMESTAMP, *PWHEA_TIMESTAMP;

