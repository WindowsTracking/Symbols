typedef struct _NDIS_MINIPORT_OFFLOAD_REG
{
  union
  {
    struct /* bitfield */
    {
      unsigned long IPv4XSumTxDisabled : 1; /* bit position: 0 */
      unsigned long IPv4XSumRxDisabled : 1; /* bit position: 1 */
      unsigned long TCPv4XSumTxDisabled : 1; /* bit position: 2 */
      unsigned long TCPv4XSumRxDisabled : 1; /* bit position: 3 */
      unsigned long UDPv4XSumTxDisabled : 1; /* bit position: 4 */
      unsigned long UDPv4XSumRxDisabled : 1; /* bit position: 5 */
      unsigned long TCPv6XSumTxDisabled : 1; /* bit position: 6 */
      unsigned long TCPv6XSumRxDisabled : 1; /* bit position: 7 */
      unsigned long UDPv6XSumTxDisabled : 1; /* bit position: 8 */
      unsigned long UDPv6XSumRxDisabled : 1; /* bit position: 9 */
      unsigned long LsoV1IPv4Disabled : 1; /* bit position: 10 */
      unsigned long LsoV2IPv4Disabled : 1; /* bit position: 11 */
      unsigned long LsoV2IPv6Disabled : 1; /* bit position: 12 */
      unsigned long IPsecAHDisabled : 1; /* bit position: 13 */
      unsigned long IPsecESPDisabled : 1; /* bit position: 14 */
      unsigned long TCPv4ConnectionOffloadDisabled : 1; /* bit position: 15 */
      unsigned long TCPv6ConnectionOffloadDisabled : 1; /* bit position: 16 */
      unsigned long ReadRegistry : 1; /* bit position: 17 */
      unsigned long IPsecV2AHDisabled : 1; /* bit position: 18 */
      unsigned long IPsecV2ESPDisabled : 1; /* bit position: 19 */
      unsigned long IPsecV2IPv4AHDisabled : 1; /* bit position: 20 */
      unsigned long IPsecV2IPv4ESPDisabled : 1; /* bit position: 21 */
      unsigned long IPSecV2IPv6Disabled : 1; /* bit position: 22 */
    }; /* bitfield */
    unsigned long Value;
  };
} NDIS_MINIPORT_OFFLOAD_REG, *PNDIS_MINIPORT_OFFLOAD_REG;

