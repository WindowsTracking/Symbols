typedef struct _NDIS_IPSEC_OFFLOAD_V1
{
  struct
  {
    unsigned long Encapsulation;
    unsigned long AhEspCombined;
    unsigned long TransportTunnelCombined;
    unsigned long IPv4Options;
    unsigned long Flags;
  } Supported;
  struct
  {
    struct /* bitfield */
    {
      unsigned long Md5 : 2; /* bit position: 0 */
      unsigned long Sha_1 : 2; /* bit position: 2 */
      unsigned long Transport : 2; /* bit position: 4 */
      unsigned long Tunnel : 2; /* bit position: 6 */
      unsigned long Send : 2; /* bit position: 8 */
      unsigned long Receive : 2; /* bit position: 10 */
    }; /* bitfield */
  } IPv4AH;
  struct
  {
    struct /* bitfield */
    {
      unsigned long Des : 2; /* bit position: 0 */
      unsigned long Reserved : 2; /* bit position: 2 */
      unsigned long TripleDes : 2; /* bit position: 4 */
      unsigned long NullEsp : 2; /* bit position: 6 */
      unsigned long Transport : 2; /* bit position: 8 */
      unsigned long Tunnel : 2; /* bit position: 10 */
      unsigned long Send : 2; /* bit position: 12 */
      unsigned long Receive : 2; /* bit position: 14 */
    }; /* bitfield */
  } IPv4ESP;
} NDIS_IPSEC_OFFLOAD_V1, *PNDIS_IPSEC_OFFLOAD_V1;

typedef struct _NDIS_IPSEC_OFFLOAD_V1_NET_BUFFER_LIST_INFO
{
  union
  {
    struct
    {
      void* OffloadHandle;
    } Transmit;
    struct
    {
      struct
      {
        struct /* bitfield */
        {
          unsigned short SaDeleteReq : 1; /* bit position: 0 */
          unsigned short CryptoDone : 1; /* bit position: 1 */
          unsigned short NextCryptoDone : 1; /* bit position: 2 */
          unsigned short Pad : 13; /* bit position: 3 */
        }; /* bitfield */
        unsigned short CryptoStatus;
      } Receive;
      long __PADDING__[1];
    };
  };
} NDIS_IPSEC_OFFLOAD_V1_NET_BUFFER_LIST_INFO, *PNDIS_IPSEC_OFFLOAD_V1_NET_BUFFER_LIST_INFO;

typedef struct _NDIS_IPSEC_OFFLOAD_V2
{
  unsigned long Encapsulation;
  unsigned char IPv6Supported;
  unsigned char IPv4Options;
  unsigned char IPv6NonIPsecExtensionHeaders;
  unsigned char Ah;
  unsigned char Esp;
  unsigned char AhEspCombined;
  unsigned char Transport;
  unsigned char Tunnel;
  unsigned char TransportTunnelCombined;
  unsigned char LsoSupported;
  unsigned char ExtendedSequenceNumbers;
  unsigned long UdpEsp;
  unsigned long AuthenticationAlgorithms;
  unsigned long EncryptionAlgorithms;
  unsigned long SaOffloadCapacity;
} NDIS_IPSEC_OFFLOAD_V2, *PNDIS_IPSEC_OFFLOAD_V2;

typedef struct _NDIS_IPSEC_OFFLOAD_V2_HEADER_NET_BUFFER_LIST_INFO
{
  union
  {
    struct
    {
      struct /* bitfield */
      {
        unsigned long NextHeader : 8; /* bit position: 0 */
        unsigned long PadLength : 8; /* bit position: 8 */
        unsigned long AhHeaderOffset : 8; /* bit position: 16 */
        unsigned long EspHeaderOffset : 8; /* bit position: 24 */
      }; /* bitfield */
    } Transmit;
    struct
    {
      struct /* bitfield */
      {
        unsigned long NextHeader : 8; /* bit position: 0 */
        unsigned long PadLength : 8; /* bit position: 8 */
        unsigned long HeaderInfoSet : 1; /* bit position: 16 */
      }; /* bitfield */
    } Receive;
