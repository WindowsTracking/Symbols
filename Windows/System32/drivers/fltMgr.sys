  {
    struct /* bitfield */
    {
      unsigned __int64 Locked : 1; /* bit position: 0 */
      unsigned __int64 Waiting : 1; /* bit position: 1 */
      unsigned __int64 Waking : 1; /* bit position: 2 */
      unsigned __int64 MultipleShared : 1; /* bit position: 3 */
      unsigned __int64 Shared : 60; /* bit position: 4 */
    }; /* bitfield */
    unsigned __int64 Value;
    void* Ptr;
  };
} EX_PUSH_LOCK, *PEX_PUSH_LOCK;

