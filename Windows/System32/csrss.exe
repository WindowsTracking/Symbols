  union
  {
    struct /* bitfield */
    {
      unsigned long Recovered : 1; /* bit position: 0 */
      unsigned long PreviousError : 1; /* bit position: 1 */
      unsigned long Simulated : 1; /* bit position: 2 */
      unsigned long Reserved : 29; /* bit position: 3 */
    }; /* bitfield */
    unsigned long AsULONG;
  };
} WHEA_ERROR_RECORD_HEADER_FLAGS, *PWHEA_ERROR_RECORD_HEADER_FLAGS;

typedef union _WHEA_ERROR_RECORD_HEADER_VALIDBITS
{
