typedef union _SLIST_HEADER
{
  union
  {
    struct
    {
      unsigned __int64 Alignment;
      unsigned __int64 Region;
    };
    struct
    {
      struct /* bitfield */
      {
        unsigned __int64 Depth : 16; /* bit position: 0 */
        unsigned __int64 Sequence : 9; /* bit position: 16 */
        unsigned __int64 NextEntry : 39; /* bit position: 25 */
      }; /* bitfield */
      struct /* bitfield */
      {
        unsigned __int64 HeaderType : 1; /* bit position: 0 */
        unsigned __int64 Init : 1; /* bit position: 1 */
        unsigned __int64 Reserved : 59; /* bit position: 2 */
        unsigned __int64 Region : 3; /* bit position: 61 */
      }; /* bitfield */
    } Header8;
    struct
    {
      struct /* bitfield */
      {
        unsigned __int64 Depth : 16; /* bit position: 0 */
        unsigned __int64 Sequence : 48; /* bit position: 16 */
      }; /* bitfield */
      struct /* bitfield */
      {
        unsigned __int64 HeaderType : 1; /* bit position: 0 */
        unsigned __int64 Init : 1; /* bit position: 1 */
        unsigned __int64 Reserved : 2; /* bit position: 2 */
        unsigned __int64 NextEntry : 60; /* bit position: 4 */
      }; /* bitfield */
    } Header16;
  };
} SLIST_HEADER, *PSLIST_HEADER;

