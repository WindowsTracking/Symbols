      unsigned long StackTracing : 1; /* bit position: 7 */
      unsigned long ErrorLogged : 1; /* bit position: 8 */
      unsigned long RealtimeLoggerContextFreed : 1; /* bit position: 9 */
      unsigned long PebsTracing : 1; /* bit position: 10 */
      unsigned long PmcCounters : 1; /* bit position: 11 */
      unsigned long PageAlignBuffers : 1; /* bit position: 12 */
      unsigned long SpareFlags1 : 3; /* bit position: 13 */
      unsigned long SystemLoggerIndex : 8; /* bit position: 16 */
      unsigned long StackCaching : 1; /* bit position: 24 */
      unsigned long SpareFlags2 : 7; /* bit position: 25 */
    }; /* bitfield */
  };
  union
  {
    volatile unsigned long RequestFlag;
    struct /* bitfield */
    {
      unsigned long DbgRequestNewFie : 1; /* bit position: 0 */
      unsigned long DbgRequestUpdateFile : 1; /* bit position: 1 */
      unsigned long DbgRequestFlush : 1; /* bit position: 2 */
      unsigned long DbgRequestDisableRealtime : 1; /* bit position: 3 */
      unsigned long DbgRequestDisconnectConsumer : 1; /* bit position: 4 */
      unsigned long DbgRequestConnectConsumer : 1; /* bit position: 5 */
      unsigned long DbgRequestNotifyConsumer : 1; /* bit position: 6 */
      unsigned long DbgRequestUpdateHeader : 1; /* bit position: 7 */
      unsigned long DbgRequestDefferdFlush : 1; /* bit position: 8 */
      unsigned long DbgRequestDefferdFlushTimer : 1; /* bit position: 9 */
      unsigned long DbgRequestFlushTimer : 1; /* bit position: 10 */
      unsigned long DbgRequestUpdateDebugger : 1; /* bit position: 11 */
      unsigned long DbgSpareRequestFlags : 20; /* bit position: 12 */
    }; /* bitfield */
  };
  struct _RTL_BITMAP HookIdMap;
  struct _ETW_STACK_CACHE* StackCache;
  struct _ETW_PMC_SUPPORT* PmcData;
  struct _LIST_ENTRY WinRtProviderBinaryList;
  struct _WMI_BUFFER_HEADER** ScratchArray;
} WMI_LOGGER_CONTEXT, *PWMI_LOGGER_CONTEXT;

