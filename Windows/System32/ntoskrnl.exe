      }; /* bitfield */
      struct /* bitfield */
      {
        unsigned long CriticalIdleOverride : 1; /* bit position: 0 */
        unsigned long ResidentOverride : 1; /* bit position: 1 */
        unsigned long Reserved : 30; /* bit position: 2 */
