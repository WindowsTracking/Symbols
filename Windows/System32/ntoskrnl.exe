typedef union _IOMMU_SVM_CAPABILITIES
{
  union
  {
    struct /* bitfield */
    {
      unsigned long AtsCapability : 1; /* bit position: 0 */
      unsigned long PriCapability : 1; /* bit position: 1 */
      unsigned long PasidCapability : 1; /* bit position: 2 */
      unsigned long Rsvd0 : 29; /* bit position: 3 */
    }; /* bitfield */
    struct
    {
      struct /* bitfield */
      {
        unsigned long Padding : 3; /* bit position: 0 */
        unsigned long PasidMaxWidth : 5; /* bit position: 3 */
        unsigned long PasidExePerm : 1; /* bit position: 8 */
        unsigned long PasidPrivMode : 1; /* bit position: 9 */
        unsigned long AtsPageAlignedRequest : 1; /* bit position: 10 */
        unsigned long AtsGlobalInvalidate : 1; /* bit position: 11 */
        unsigned long AtsInvalidateQueueDepth : 5; /* bit position: 12 */
        unsigned long PriPrgResponsePasidRequired : 1; /* bit position: 17 */
        unsigned long Rsvd : 14; /* bit position: 18 */
      }; /* bitfield */
    } CapReg;
    struct
    {
      struct /* bitfield */
      {
        unsigned long Padding : 18; /* bit position: 0 */
        unsigned long AtsEnable : 1; /* bit position: 18 */
        unsigned long PriEnable : 1; /* bit position: 19 */
        unsigned long PasidEnable : 1; /* bit position: 20 */
        unsigned long ExecutePermissionEnable : 1; /* bit position: 21 */
        unsigned long PrivilegedModeEnable : 1; /* bit position: 22 */
        unsigned long Rsvd : 9; /* bit position: 23 */
      }; /* bitfield */
    } EnabledCaps;
    struct
    {
      struct /* bitfield */
      {
        unsigned long Padding : 23; /* bit position: 0 */
        unsigned long IsSecureDevice : 1; /* bit position: 23 */
        unsigned long Rsvd : 8; /* bit position: 24 */
      }; /* bitfield */
    } DeviceInformation;
    struct /* bitfield */
    {
      unsigned long AtsPriPasidBits : 3; /* bit position: 0 */
      unsigned long CapRegBits : 15; /* bit position: 3 */
      unsigned long EnabledCapsBits : 5; /* bit position: 18 */
      unsigned long DeviceInformationBits : 1; /* bit position: 23 */
      unsigned long Rsvd1 : 8; /* bit position: 24 */
    }; /* bitfield */
    unsigned long AsULONG;
  };
} IOMMU_SVM_CAPABILITIES, *PIOMMU_SVM_CAPABILITIES;

