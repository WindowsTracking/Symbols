  unsigned short BufferType;
  union
  {
    unsigned long Padding1[4];
    struct _ETW_REF_CLOCK ReferenceTime;
    struct _LIST_ENTRY GlobalEntry;
    struct
    {
      void* Pointer0;
      void* Pointer1;
    };
  };
} WMI_BUFFER_HEADER, *PWMI_BUFFER_HEADER;

typedef struct _WMI_LOGGER_CONTEXT
{
  unsigned long LoggerId;
  unsigned long BufferSize;
  unsigned long MaximumEventSize;
  long CollectionOn;
  unsigned long LoggerMode;
  long AcceptNewEvents;
  void* GetCpuClock /* function */;
  union _LARGE_INTEGER StartTime;
  void* LogFileHandle;
  struct _ETHREAD* LoggerThread;
  long LoggerStatus;
  void* NBQHead;
  void* OverflowNBQHead;
  union _SLIST_HEADER QueueBlockFreeList;
  struct _LIST_ENTRY GlobalList;
  union
  {
    struct _WMI_BUFFER_HEADER* BatchedBufferList;
    struct _EX_FAST_REF CurrentBuffer;
  };
  struct _UNICODE_STRING LoggerName;
  struct _UNICODE_STRING LogFileName;
  struct _UNICODE_STRING LogFilePattern;
  struct _UNICODE_STRING NewLogFileName;
  unsigned long ClockType;
  unsigned long MaximumFileSize;
  unsigned long LastFlushedBuffer;
  unsigned long FlushTimer;
  unsigned long FlushThreshold;
  union _LARGE_INTEGER ByteOffset;
  unsigned long MinimumBuffers;
  volatile long BuffersAvailable;
  volatile long NumberOfBuffers;
  unsigned long MaximumBuffers;
  volatile unsigned long EventsLost;
  unsigned long BuffersWritten;
  unsigned long LogBuffersLost;
  unsigned long RealTimeBuffersDelivered;
  unsigned long RealTimeBuffersLost;
  long* SequencePtr;
  unsigned long LocalSequence;
  struct _GUID InstanceGuid;
  long FileCounter;
  void* volatile BufferCallback /* function */;
  enum _POOL_TYPE PoolType;
  struct _ETW_REF_CLOCK ReferenceTime;
  struct _LIST_ENTRY Consumers;
  unsigned long NumConsumers;
  struct _ETW_REALTIME_CONSUMER* TransitionConsumer;
  void* RealtimeLogfileHandle;
  struct _UNICODE_STRING RealtimeLogfileName;
  union _LARGE_INTEGER RealtimeWriteOffset;
  union _LARGE_INTEGER RealtimeReadOffset;
  union _LARGE_INTEGER RealtimeLogfileSize;
  unsigned __int64 RealtimeLogfileUsage;
  unsigned __int64 RealtimeMaximumFileSize;
  unsigned long RealtimeBuffersSaved;
  struct _ETW_REF_CLOCK RealtimeReferenceTime;
  enum _ETW_RT_EVENT_LOSS NewRTEventsLost;
  struct _KEVENT LoggerEvent;
  struct _KEVENT FlushEvent;
  struct _KTIMER FlushTimeOutTimer;
  struct _KDPC FlushDpc;
  struct _KMUTANT LoggerMutex;
  struct _EX_PUSH_LOCK LoggerLock;
  union
  {
    unsigned __int64 BufferListSpinLock;
    struct _EX_PUSH_LOCK BufferListPushLock;
  };
  struct _SECURITY_CLIENT_CONTEXT ClientSecurityContext;
  struct _EX_FAST_REF SecurityDescriptor;
  __int64 BufferSequenceNumber;
  union
  {
    unsigned long Flags;
    struct /* bitfield */
    {
      unsigned long Persistent : 1; /* bit position: 0 */
      unsigned long AutoLogger : 1; /* bit position: 1 */
      unsigned long FsReady : 1; /* bit position: 2 */
      unsigned long RealTime : 1; /* bit position: 3 */
      unsigned long Wow : 1; /* bit position: 4 */
      unsigned long KernelTrace : 1; /* bit position: 5 */
      unsigned long NoMoreEnable : 1; /* bit position: 6 */
      unsigned long StackTracing : 1; /* bit position: 7 */
      unsigned long ErrorLogged : 1; /* bit position: 8 */
      unsigned long RealtimeLoggerContextFreed : 1; /* bit position: 9 */
    }; /* bitfield */
  };
  union
  {
    unsigned long RequestFlag;
    struct /* bitfield */
    {
      unsigned long RequestNewFie : 1; /* bit position: 0 */
      unsigned long RequestUpdateFile : 1; /* bit position: 1 */
      unsigned long RequestFlush : 1; /* bit position: 2 */
      unsigned long RequestDisableRealtime : 1; /* bit position: 3 */
      unsigned long RequestDisconnectConsumer : 1; /* bit position: 4 */
      unsigned long RequestConnectConsumer : 1; /* bit position: 5 */
    }; /* bitfield */
  };
  struct _RTL_BITMAP HookIdMap;
  long __PADDING__[2];
} WMI_LOGGER_CONTEXT, *PWMI_LOGGER_CONTEXT;

typedef struct _WMI_TRACE_PACKET
{
  unsigned short Size;
  union
  {
    unsigned short HookId;
    struct
    {
      unsigned char Type;
      unsigned char Group;
    };
  };
} WMI_TRACE_PACKET, *PWMI_TRACE_PACKET;

