      unsigned short AdvancedCapsAndControlRW : 1; /* bit position: 3 */
      unsigned short SecondaryUncorrectableErrorMaskRW : 1; /* bit position: 4 */
      unsigned short SecondaryUncorrectableErrorSevRW : 1; /* bit position: 5 */
      unsigned short SecondaryCapsAndControlRW : 1; /* bit position: 6 */
      unsigned short Reserved : 9; /* bit position: 7 */
    }; /* bitfield */
    unsigned short AsUSHORT;
  };
} AER_BRIDGE_DESCRIPTOR_FLAGS, *PAER_BRIDGE_DESCRIPTOR_FLAGS;

