  unsigned long ResumeContextPages;
  struct /* bitfield */
  {
    unsigned long Hiberboot : 1; /* bit position: 0 */
    unsigned long SecureLaunched : 1; /* bit position: 1 */
    unsigned long SecureBoot : 1; /* bit position: 2 */
