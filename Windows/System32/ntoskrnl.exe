typedef struct _POOL_HEADER
{
  union
  {
    struct
    {
      struct /* bitfield */
      {
        unsigned short PreviousSize : 8; /* bit position: 0 */
        unsigned short PoolIndex : 8; /* bit position: 8 */
      }; /* bitfield */
      struct /* bitfield */
      {
        unsigned short BlockSize : 8; /* bit position: 0 */
        unsigned short PoolType : 8; /* bit position: 8 */
      }; /* bitfield */
    };
    unsigned long Ulong1;
  };
  unsigned long PoolTag;
  union
  {
    struct _EPROCESS* ProcessBilled;
    struct
    {
      unsigned short AllocatorBackTraceIndex;
      unsigned short PoolTagHash;
      long __PADDING__[1];
    };
  };
} POOL_HEADER, *PPOOL_HEADER;

