      unsigned short CorrectableErrorMaskRW : 1; /* bit position: 2 */
      unsigned short AdvancedCapsAndControlRW : 1; /* bit position: 3 */
      unsigned short Reserved : 12; /* bit position: 4 */
    }; /* bitfield */
    unsigned short AsUSHORT;
  };
} AER_ENDPOINT_DESCRIPTOR_FLAGS, *PAER_ENDPOINT_DESCRIPTOR_FLAGS;

typedef union _AER_ROOTPORT_DESCRIPTOR_FLAGS
