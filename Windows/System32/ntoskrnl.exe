typedef struct _ACPI_SRAT_ENTRY
{
  unsigned char Type;
  unsigned char Length;
  union
  {
    struct
    {
      unsigned char ProximityDomainLow;
      unsigned char ApicId;
      struct
      {
        struct /* bitfield */
        {
          unsigned long Enabled : 1; /* bit position: 0 */
          unsigned long Reserved : 31; /* bit position: 1 */
        }; /* bitfield */
      } Flags;
      unsigned char SApicEid;
      unsigned char ProximityDomainHigh[3];
      unsigned long ClockDomain;
    } ApicAffinity;
    struct
    {
      unsigned long ProximityDomain;
      unsigned char Reserved[2];
      union _LARGE_INTEGER Base;
      unsigned __int64 Length;
      unsigned long Reserved2;
      struct
      {
        struct /* bitfield */
        {
          unsigned long Enabled : 1; /* bit position: 0 */
          unsigned long HotPlug : 1; /* bit position: 1 */
          unsigned long NonVolatile : 1; /* bit position: 2 */
          unsigned long SpecificPurpose : 1; /* bit position: 3 */
          unsigned long Reserved : 28; /* bit position: 4 */
        }; /* bitfield */
      } Flags;
      unsigned char Reserved3[8];
    } MemoryAffinity;
    struct
    {
      unsigned char Reserved[2];
      unsigned long ProximityDomain;
      unsigned long ApicId;
      struct
      {
        struct /* bitfield */
        {
          unsigned long Enabled : 1; /* bit position: 0 */
          unsigned long Reserved : 31; /* bit position: 1 */
        }; /* bitfield */
      } Flags;
      unsigned long ClockDomain;
      unsigned long Reserved2;
    } X2ApicAffinity;
    struct
    {
      unsigned long ProximityDomain;
      unsigned long ProcessorUid;
      struct
      {
        struct /* bitfield */
        {
          unsigned long Enabled : 1; /* bit position: 0 */
          unsigned long Reserved : 31; /* bit position: 1 */
        }; /* bitfield */
      } Flags;
      unsigned long ClockDomain;
    } GiccAffinity;
    struct
    {
      unsigned long ProximityDomain;
      unsigned char Reserved[2];
      unsigned long ITSID;
    } GicItsAffinity;
    struct
    {
      unsigned char Reserved;
      unsigned char DeviceHandleType;
      unsigned long ProximityDomain;
      union
      {
        union
        {
          struct
          {
            unsigned char ACPI_HID[8];
            unsigned long ACPI_UID;
            unsigned long Reserved;
          } ACPI;
          struct
          {
            unsigned short PCISegment;
            unsigned short PCIBDFNumber;
            unsigned char Reserved[12];
          } PCI;
        };
      } DeviceHandle;
      struct
      {
        struct /* bitfield */
        {
          unsigned long Enabled : 1; /* bit position: 0 */
          unsigned long ArchitecturalTransactions : 1; /* bit position: 1 */
          unsigned long Reserved : 30; /* bit position: 2 */
        }; /* bitfield */
      } Flags;
      unsigned long Reserved2;
    } GenericInitiatorAffinity;
    struct
    {
      struct
      {
        unsigned char Reserved;
        unsigned char DeviceHandleType;
        unsigned long ProximityDomain;
        union
        {
          union
          {
            struct
            {
              unsigned char ACPI_HID[8];
              unsigned long ACPI_UID;
              unsigned long Reserved;
            } ACPI;
            struct
            {
              unsigned short PCISegment;
              unsigned short PCIBDFNumber;
              unsigned char Reserved[12];
            } PCI;
          };
        } DeviceHandle;
        struct
        {
          struct /* bitfield */
          {
            unsigned long Enabled : 1; /* bit position: 0 */
            unsigned long ArchitecturalTransactions : 1; /* bit position: 1 */
            unsigned long Reserved : 30; /* bit position: 2 */
          }; /* bitfield */
        } Flags;
        unsigned long Reserved2;
      } GenericPortAffinity;
      long __PADDING__[2];
    };
  };
} ACPI_SRAT_ENTRY, *PACPI_SRAT_ENTRY;

