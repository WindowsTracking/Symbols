    unsigned long SuppressResumePrompt : 1; /* bit position: 8 */
    unsigned long Reserved : 23; /* bit position: 9 */
  }; /* bitfield */
  unsigned __int64 HvPageTableRoot;
  unsigned __int64 HvEntryPoint;
  unsigned __int64 HvReservedTransitionAddress;
