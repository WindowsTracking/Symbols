  {
    enum BlockingReason _blockingReason : 2; /* bit position: 0 */
    enum ASTAWaitWindowMessageDispatch _windowMessageDispatchBehavior : 2; /* bit position: 2 */
  }; /* bitfield */
  const unsigned long _dwThreadIdWaitingFor;
  const unsigned __int64 _uStartTickCount;
  struct /* bitfield */
  {
    const BOOL _bAllWaitsAreAlertable : 1; /* bit position: 0 */
    const BOOL _bDispatchesAllCalls : 1; /* bit position: 1 */
    BOOL _bWaitedAtLeastOnce : 1; /* bit position: 2 */
