typedef struct _SYSTEM_POWER_STATE_CONTEXT
{
  union
  {
    struct /* bitfield */
    {
      unsigned long Reserved1 : 8; /* bit position: 0 */
      unsigned long TargetSystemState : 4; /* bit position: 8 */
      unsigned long EffectiveSystemState : 4; /* bit position: 12 */
      unsigned long CurrentSystemState : 4; /* bit position: 16 */
      unsigned long IgnoreHibernationPath : 1; /* bit position: 20 */
      unsigned long PseudoTransition : 1; /* bit position: 21 */
      unsigned long Reserved2 : 10; /* bit position: 22 */
    }; /* bitfield */
    unsigned long ContextAsUlong;
  };
} SYSTEM_POWER_STATE_CONTEXT, *PSYSTEM_POWER_STATE_CONTEXT;

