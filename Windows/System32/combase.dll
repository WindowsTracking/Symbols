typedef struct _ETW_AUTOBOOST_SET_PRIORITY_FLOOR_EVENT
{
  void* Lock;
  unsigned long ThreadId;
  char NewCpuPriorityFloor;
  char OldCpuPriority;
  union
  {
    struct /* bitfield */
    {
      char NewIoPriorityFloor : 3; /* bit position: 0 */
      char OldIoPriority : 3; /* bit position: 3 */
      char NewIoQoSPriorityFloor : 1; /* bit position: 6 */
      char OldIoQoSPriority : 1; /* bit position: 7 */
    }; /* bitfield */
    char IoPriorities;
  };
  union
  {
    struct /* bitfield */
    {
      unsigned char ExecutingDpc : 1; /* bit position: 0 */
      unsigned char WakeupBoost : 1; /* bit position: 1 */
      unsigned char BoostedOutstandingIrps : 2; /* bit position: 2 */
      unsigned char Reserved : 4; /* bit position: 4 */
    }; /* bitfield */
