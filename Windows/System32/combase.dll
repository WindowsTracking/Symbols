typedef union _ARM64_FPCR_REG
{
  union
  {
    unsigned long Value;
    struct /* bitfield */
    {
      unsigned long res0_1 : 8; /* bit position: 0 */
      unsigned long IOE : 1; /* bit position: 8 */
      unsigned long DZE : 1; /* bit position: 9 */
      unsigned long OFE : 1; /* bit position: 10 */
      unsigned long UFE : 1; /* bit position: 11 */
      unsigned long IXE : 1; /* bit position: 12 */
      unsigned long res0_2 : 2; /* bit position: 13 */
      unsigned long IDE : 1; /* bit position: 15 */
      unsigned long Len : 3; /* bit position: 16 */
      unsigned long FZ16 : 1; /* bit position: 19 */
      unsigned long Stride : 2; /* bit position: 20 */
      unsigned long RMode : 2; /* bit position: 22 */
      unsigned long FZ : 1; /* bit position: 24 */
      unsigned long DN : 1; /* bit position: 25 */
      unsigned long AHP : 1; /* bit position: 26 */
      unsigned long res0_3 : 5; /* bit position: 27 */
    }; /* bitfield */
  };
} ARM64_FPCR_REG, *PARM64_FPCR_REG;

typedef union _ARM64_FPSR_REG
{
  union
  {
    unsigned long Value;
    struct /* bitfield */
    {
      unsigned long IOC : 1; /* bit position: 0 */
      unsigned long DZC : 1; /* bit position: 1 */
      unsigned long OFC : 1; /* bit position: 2 */
      unsigned long UFC : 1; /* bit position: 3 */
      unsigned long IXC : 1; /* bit position: 4 */
      unsigned long res0_1 : 2; /* bit position: 5 */
      unsigned long IDC : 1; /* bit position: 7 */
      unsigned long res0_2 : 19; /* bit position: 8 */
      unsigned long QC : 1; /* bit position: 27 */
      unsigned long V : 1; /* bit position: 28 */
      unsigned long C : 1; /* bit position: 29 */
      unsigned long Z : 1; /* bit position: 30 */
      unsigned long N : 1; /* bit position: 31 */
    }; /* bitfield */
  };
} ARM64_FPSR_REG, *PARM64_FPSR_REG;

