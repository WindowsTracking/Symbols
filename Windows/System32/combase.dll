    BOOL _bDroppedInputMessage : 1; /* bit position: 4 */
    BOOL _bReportedDroppedKeyboard : 1; /* bit position: 5 */
    BOOL _bReportedDroppedMouse : 1; /* bit position: 6 */
    BOOL _bReportedDroppedQueueSync : 1; /* bit position: 7 */
  }; /* bitfield */
  const struct _GUID _logicalThreadId;
  class CComApartment& _apartment;
  struct ASTAState& _state;
  unsigned long _dwAccumulatedWaitTime;
};

