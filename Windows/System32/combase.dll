typedef struct _WMI_BUFFER_HEADER
{
  unsigned long BufferSize;
  unsigned long SavedOffset;
  volatile unsigned long CurrentOffset;
  volatile long ReferenceCount;
  union _LARGE_INTEGER TimeStamp;
  __int64 SequenceNumber;
  union
  {
    struct /* bitfield */
    {
      unsigned __int64 ClockType : 3; /* bit position: 0 */
      unsigned __int64 Frequency : 61; /* bit position: 3 */
    }; /* bitfield */
    struct _SINGLE_LIST_ENTRY SlistEntry;
    struct _WMI_BUFFER_HEADER* NextBuffer;
  };
  struct _ETW_BUFFER_CONTEXT ClientContext;
  enum _ETW_BUFFER_STATE State;
  unsigned long Offset;
  unsigned short BufferFlag;
  unsigned short BufferType;
  union
  {
    unsigned long Padding1[4];
    struct _ETW_REF_CLOCK ReferenceTime;
    struct _LIST_ENTRY GlobalEntry;
    struct
    {
      void* Pointer0;
      void* Pointer1;
    };
  };
} WMI_BUFFER_HEADER, *PWMI_BUFFER_HEADER;

typedef struct _WMI_CONTEXTSWAP
{
  unsigned long NewThreadId;
  unsigned long OldThreadId;
  char NewThreadPriority;
  char OldThreadPriority;
  union
  {
    unsigned char PreviousCState;
    unsigned char OldThreadRank;
  };
  union
  {
    char NewThreadPriorityDecrement;
    char SpareByte;
  };
  unsigned char OldThreadWaitReason;
  union
  {
    struct /* bitfield */
    {
      unsigned char OldThreadWaitMode : 1; /* bit position: 0 */
      unsigned char OldThreadBamQosLevel : 3; /* bit position: 1 */
      unsigned char NewThreadBamQosLevel : 3; /* bit position: 4 */
      unsigned char Reserved : 1; /* bit position: 7 */
    }; /* bitfield */
    unsigned char Flags;
  };
  unsigned char OldThreadState;
  unsigned char OldThreadIdealProcessor;
  unsigned long NewThreadWaitTime;
  long OldThreadRemainingQuantum;
} WMI_CONTEXTSWAP, *PWMI_CONTEXTSWAP;

