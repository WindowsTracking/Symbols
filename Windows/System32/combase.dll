struct wil_details_FeatureDescriptor
{
  union wil_details_FeatureStateCache* featureStateCache;
  struct wil_details_FeatureReportingCache* featureReportingCache;
  unsigned int featureId;
  unsigned char changeTime;
  unsigned char isAlwaysDisabled;
  unsigned char isAlwaysEnabled;
  unsigned char isEnabledByDefault;
  const struct wil_details_FeatureDescriptor* const* requiresFeatures;
  unsigned char variant;
  enum wil_FeatureVariantPayloadKind payloadKind;
  unsigned int payload;
  long __PADDING__[1];
};

struct wil_details_FeatureReportingCache
{
  union wil_details_ReportedState reported;
  union wil_details_RecordedState recorded;
};

union wil_details_FeatureStateCache
{
  union
  {
    unsigned int exchange;
    struct
    {
      struct /* bitfield */
      {
        unsigned int stateCached : 1; /* bit position: 0 */
        unsigned int hasNotificationCached : 1; /* bit position: 1 */
        unsigned int variantCached : 1; /* bit position: 2 */
        unsigned int effectiveState : 1; /* bit position: 3 */
        unsigned int desiredState : 1; /* bit position: 4 */
        unsigned int configuredState : 2; /* bit position: 5 */
        unsigned int needsRefresh : 1; /* bit position: 7 */
        unsigned int hasNotification : 1; /* bit position: 8 */
        unsigned int isWexpConfiguration : 1; /* bit position: 9 */
        unsigned int variant : 6; /* bit position: 10 */
        unsigned int unused : 16; /* bit position: 16 */
      }; /* bitfield */
      unsigned int payloadId;
    };
    unsigned __int64 exchange64;
  };
};

struct wil_details_FeatureTestState
{
  enum wil_details_FeatureTestStateKind kind;
  unsigned int featureId;
  enum wil_FeatureEnabledState state;
  unsigned char variant;
  unsigned int payload;
  enum wil_FeatureVariantPayloadKind payloadKind;
  struct wil_details_FeatureTestState* next;
};

enum wil_details_FeatureTestStateKind
{
  wil_details_FeatureTestStateKind_EnabledState = 0,
  wil_details_FeatureTestStateKind_Variant = 1,
};

struct wil_details_FeatureUsageSRUM
{
  unsigned int featureId;
  unsigned short serviceReportingKind;
  unsigned long usageCount;
};

struct wil_details_RecordCachedUsage::__l2::Change
{
  enum wil_details_ServiceReportingKind kind;
  unsigned int count;
};

union wil_details_RecordedState
{
  union
  {
    unsigned int exchange;
    struct /* bitfield */
    {
      unsigned int recordedDeviceUsage : 1; /* bit position: 0 */
      unsigned int recordedDevicePotential : 1; /* bit position: 1 */
      unsigned int recordedDeviceOpportunity : 1; /* bit position: 2 */
      unsigned int recordedDevicePotentialOpportunity : 1; /* bit position: 3 */
      unsigned int recordedVariantDeviceUsage : 1; /* bit position: 4 */
      unsigned int recordedVariant : 6; /* bit position: 5 */
      unsigned int unused : 21; /* bit position: 11 */
    }; /* bitfield */
  };
};

struct wil_details_RecordUsageResult
{
  int queueBackground;
  unsigned int countImmediate;
  enum wil_details_ServiceReportingKind kindImmediate;
  unsigned int payloadId;
  int ignoredUse;
  int isWexpConfiguration;
};

union wil_details_ReportedState
{
  union
  {
    unsigned int exchange;
    struct /* bitfield */
    {
      unsigned int queuedForReporting : 1; /* bit position: 0 */
      unsigned int reportedDeviceUsage : 1; /* bit position: 1 */
      unsigned int reportedDevicePotential : 1; /* bit position: 2 */
      unsigned int reportedDeviceOpportunity : 1; /* bit position: 3 */
      unsigned int reportedDevicePotentialOpportunity : 1; /* bit position: 4 */
      unsigned int usageCount : 9; /* bit position: 5 */
      unsigned int usageCountRepresentsPotential : 1; /* bit position: 14 */
      unsigned int opportunityCount : 7; /* bit position: 15 */
      unsigned int opportunityCountRepresentsPotential : 1; /* bit position: 22 */
      unsigned int unused : 9; /* bit position: 23 */
    }; /* bitfield */
  };
};

enum wil_details_ServiceReportingKind
