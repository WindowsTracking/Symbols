typedef struct _NDR_PROC_CONTEXT
{
  enum SYNTAX_TYPE CurrentSyntaxType;
  union
  {
    struct _NDR_PROC_INFO NdrInfo;
    struct _NDR64_PROC_FORMAT* Ndr64Header;
  };
  const unsigned char* pProcFormat;
  unsigned long NumberParams;
  void* Params;
  unsigned char* StartofStack;
  unsigned char HandleType;
  unsigned char CorrIncrement;
  void* SavedGenericHandle;
  const unsigned char* pHandleFormatSave;
  const unsigned char* DceTypeFormatString;
  struct /* bitfield */
  {
    unsigned long IsAsync : 1; /* bit position: 0 */
    unsigned long IsObject : 1; /* bit position: 1 */
    unsigned long HasPipe : 1; /* bit position: 2 */
    unsigned long HasComplexReturn : 1; /* bit position: 3 */
    unsigned long NeedsResend : 1; /* bit position: 4 */
    unsigned long UseLocator : 1; /* bit position: 5 */
    unsigned long Reserved7 : 1; /* bit position: 6 */
    unsigned long Reserved8 : 1; /* bit position: 7 */
    unsigned long Reservedleft : 8; /* bit position: 8 */
  }; /* bitfield */
  unsigned long FloatDoubleMask;
  unsigned long ResendCount;
  unsigned long RpcFlags;
