    struct /* bitfield */
    {
      unsigned __int64 Seconds : 8; /* bit position: 0 */
      unsigned __int64 Minutes : 8; /* bit position: 8 */
      unsigned __int64 Hours : 8; /* bit position: 16 */
      unsigned __int64 Precise : 1; /* bit position: 24 */
      unsigned __int64 Reserved : 7; /* bit position: 25 */
      unsigned __int64 Day : 8; /* bit position: 32 */
      unsigned __int64 Month : 8; /* bit position: 40 */
      unsigned __int64 Year : 8; /* bit position: 48 */
      unsigned __int64 Century : 8; /* bit position: 56 */
    }; /* bitfield */
    union _LARGE_INTEGER AsLARGE_INTEGER;
  };
} WHEA_TIMESTAMP, *PWHEA_TIMESTAMP;

typedef struct _WHEA_XPF_MCA_SECTION
{
  unsigned long VersionNumber;
  enum _WHEA_CPU_VENDOR CpuVendor;
  union _LARGE_INTEGER Timestamp;
  unsigned long ProcessorNumber;
  union _MCG_STATUS GlobalStatus;
  unsigned __int64 InstructionPointer;
  unsigned long BankNumber;
  union _MCI_STATUS Status;
  unsigned __int64 Address;
  unsigned __int64 Misc;
  unsigned long ExtendedRegisterCount;
  unsigned long Reserved2;
  unsigned __int64 ExtendedRegisters[24];
} WHEA_XPF_MCA_SECTION, *PWHEA_XPF_MCA_SECTION;

typedef struct _WHEA_XPF_PROCESSOR_ERROR_SECTION
{
  union _WHEA_XPF_PROCESSOR_ERROR_SECTION_VALIDBITS ValidBits;
  unsigned __int64 LocalAPICId;
  unsigned char CpuId[48];
  unsigned char VariableInfo[1];
} WHEA_XPF_PROCESSOR_ERROR_SECTION, *PWHEA_XPF_PROCESSOR_ERROR_SECTION;

typedef union _WHEA_XPF_PROCESSOR_ERROR_SECTION_VALIDBITS
{
  union
  {
    struct /* bitfield */
    {
      unsigned __int64 LocalAPICId : 1; /* bit position: 0 */
      unsigned __int64 CpuId : 1; /* bit position: 1 */
      unsigned __int64 ProcInfoCount : 6; /* bit position: 2 */
      unsigned __int64 ContextInfoCount : 6; /* bit position: 8 */
      unsigned __int64 Reserved : 50; /* bit position: 14 */
    }; /* bitfield */
    unsigned __int64 ValidBits;
  };
} WHEA_XPF_PROCESSOR_ERROR_SECTION_VALIDBITS, *PWHEA_XPF_PROCESSOR_ERROR_SECTION_VALIDBITS;

typedef struct _WORK_QUEUE_ITEM
{
  struct _LIST_ENTRY List;
  void* WorkerRoutine /* function */;
  void* Parameter;
} WORK_QUEUE_ITEM, *PWORK_QUEUE_ITEM;

typedef struct _XSAVE_FORMAT
{
  unsigned short ControlWord;
  unsigned short StatusWord;
  unsigned char TagWord;
  unsigned char Reserved1;
  unsigned short ErrorOpcode;
  unsigned long ErrorOffset;
  unsigned short ErrorSelector;
  unsigned short Reserved2;
  unsigned long DataOffset;
  unsigned short DataSelector;
  unsigned short Reserved3;
  unsigned long MxCsr;
  unsigned long MxCsr_Mask;
  struct _M128A FloatRegisters[8];
  struct _M128A XmmRegisters[16];
  unsigned char Reserved4[96];
} XSAVE_FORMAT, *PXSAVE_FORMAT;

typedef struct _XSTATE_CONFIGURATION
{
  unsigned __int64 EnabledFeatures;
  unsigned __int64 EnabledVolatileFeatures;
  unsigned long Size;
  unsigned long OptimizedSave : 1; /* bit position: 0 */
  struct _XSTATE_FEATURE Features[64];
} XSTATE_CONFIGURATION, *PXSTATE_CONFIGURATION;

typedef struct _XSTATE_FEATURE
{
  unsigned long Offset;
  unsigned long Size;
} XSTATE_FEATURE, *PXSTATE_FEATURE;

