            unsigned char QueueReservedControlFlags : 6; /* bit position: 2 */
          }; /* bitfield */
          unsigned char QueueSize;
          unsigned char QueueReserved;
        };
      };
    };
    struct
    {
      unsigned char ThreadType;
      unsigned char ThreadReserved;
      union
      {
        unsigned char ThreadControlFlags;
        struct
        {
          struct /* bitfield */
          {
            unsigned char CycleProfiling : 1; /* bit position: 0 */
            unsigned char CounterProfiling : 1; /* bit position: 1 */
            unsigned char GroupScheduling : 1; /* bit position: 2 */
            unsigned char AffinitySet : 1; /* bit position: 3 */
            unsigned char Tagged : 1; /* bit position: 4 */
            unsigned char EnergyProfiling : 1; /* bit position: 5 */
            unsigned char ThreadReservedControlFlags : 2; /* bit position: 6 */
          }; /* bitfield */
          union
          {
            unsigned char DebugActive;
            struct /* bitfield */
            {
              unsigned char ActiveDR7 : 1; /* bit position: 0 */
              unsigned char Instrumented : 1; /* bit position: 1 */
              unsigned char Minimal : 1; /* bit position: 2 */
              unsigned char Reserved4 : 3; /* bit position: 3 */
              unsigned char UmsScheduled : 1; /* bit position: 6 */
              unsigned char UmsPrimary : 1; /* bit position: 7 */
            }; /* bitfield */
          };
        };
      };
    };
    struct
    {
      unsigned char MutantType;
      unsigned char MutantSize;
      unsigned char DpcActive;
      unsigned char MutantReserved;
    };
  };
  long SignalState;
  struct _LIST_ENTRY WaitListHead;
} DISPATCHER_HEADER, *PDISPATCHER_HEADER;

