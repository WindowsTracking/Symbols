      } Interrupt;
      struct
      {
        union
        {
          struct
          {
            unsigned short Group;
            unsigned short MessageCount;
            unsigned long Vector;
            unsigned __int64 Affinity;
          } Raw;
          struct
          {
            unsigned short Level;
            unsigned short Group;
            unsigned long Vector;
            unsigned __int64 Affinity;
          } Translated;
        };
      } MessageInterrupt;
      struct
      {
        union _LARGE_INTEGER Start;
        unsigned long Length;
      } Memory;
      struct
      {
        unsigned long Channel;
        unsigned long Port;
        unsigned long Reserved1;
      } Dma;
      struct
      {
        unsigned long Channel;
        unsigned long RequestLine;
        unsigned char TransferWidth;
        unsigned char Reserved1;
        unsigned char Reserved2;
        unsigned char Reserved3;
      } DmaV3;
      struct
      {
        unsigned long Data[3];
      } DevicePrivate;
      struct
      {
        unsigned long Start;
        unsigned long Length;
        unsigned long Reserved;
      } BusNumber;
      struct
      {
        unsigned long DataSize;
        unsigned long Reserved1;
        unsigned long Reserved2;
      } DeviceSpecificData;
      struct
      {
        union _LARGE_INTEGER Start;
        unsigned long Length40;
      } Memory40;
      struct
      {
        union _LARGE_INTEGER Start;
        unsigned long Length48;
      } Memory48;
      struct
      {
        union _LARGE_INTEGER Start;
        unsigned long Length64;
      } Memory64;
      struct
      {
        unsigned char Class;
        unsigned char Type;
        unsigned char Reserved1;
        unsigned char Reserved2;
        unsigned long IdLowPart;
        unsigned long IdHighPart;
      } Connection;
    };
  } u;
} CM_PARTIAL_RESOURCE_DESCRIPTOR, *PCM_PARTIAL_RESOURCE_DESCRIPTOR;

