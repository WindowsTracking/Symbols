  {
    struct _LIST_ENTRY WaitListEntry;
    struct _SINGLE_LIST_ENTRY SwapListEntry;
  };
  struct _KQUEUE* Queue;
  void* Teb;
  union
  {
    struct _KTIMER Timer;
    struct
    {
      unsigned char TimerFill[60];
      union
      {
        struct /* bitfield */
        {
          volatile unsigned long AutoAlignment : 1; /* bit position: 0 */
          volatile unsigned long DisableBoost : 1; /* bit position: 1 */
          volatile unsigned long EtwStackTraceApc1Inserted : 1; /* bit position: 2 */
          volatile unsigned long EtwStackTraceApc2Inserted : 1; /* bit position: 3 */
          volatile unsigned long CycleChargePending : 1; /* bit position: 4 */
          volatile unsigned long CalloutActive : 1; /* bit position: 5 */
          volatile unsigned long ApcQueueable : 1; /* bit position: 6 */
          volatile unsigned long EnableStackSwap : 1; /* bit position: 7 */
          volatile unsigned long GuiThread : 1; /* bit position: 8 */
          volatile unsigned long ReservedFlags : 23; /* bit position: 9 */
        }; /* bitfield */
        volatile long ThreadFlags;
      };
    };
  };
  union
  {
    struct _KWAIT_BLOCK WaitBlock[4];
    struct
    {
      unsigned char WaitBlockFill0[43];
      unsigned char IdealProcessor;
    };
    struct
    {
      unsigned char WaitBlockFill1[91];
      char PreviousMode;
    };
    struct
    {
      unsigned char WaitBlockFill2[139];
      unsigned char ResourceIndex;
    };
    struct
    {
      unsigned char WaitBlockFill3[187];
      unsigned char LargeStack;
    };
    struct
    {
      unsigned char WaitBlockFill4[44];
      unsigned long ContextSwitches;
    };
    struct
    {
      unsigned char WaitBlockFill5[92];
      volatile unsigned char State;
      unsigned char NpxState;
      unsigned char WaitIrql;
      char WaitMode;
    };
    struct
    {
      unsigned char WaitBlockFill6[140];
      unsigned long WaitTime;
    };
    struct
    {
      unsigned char WaitBlockFill7[188];
      union
      {
        struct
        {
          short KernelApcDisable;
          short SpecialApcDisable;
        };
        unsigned long CombinedApcDisable;
      };
    };
  };
  struct _LIST_ENTRY QueueListEntry;
  struct _KTRAP_FRAME* TrapFrame;
  void* FirstArgument;
  union
  {
    void* CallbackStack;
    unsigned __int64 CallbackDepth;
  };
  unsigned char ApcStateIndex;
  char BasePriority;
  char PriorityDecrement;
  unsigned char Preempted;
  unsigned char AdjustReason;
  char AdjustIncrement;
  unsigned char Spare01;
  char Saturation;
  unsigned long SystemCallNumber;
  unsigned long FreezeCount;
  unsigned __int64 UserAffinity;
  struct _KPROCESS* Process;
  volatile unsigned __int64 Affinity;
  struct _KAPC_STATE* ApcStatePointer[2];
  union
  {
    struct _KAPC_STATE SavedApcState;
    struct
    {
      unsigned char SavedApcStateFill[43];
      unsigned char Spare02;
      char SuspendCount;
      unsigned char UserIdealProcessor;
      unsigned char Spare03;
      unsigned char CodePatchInProgress;
    };
  };
  void* volatile Win32Thread;
  void* StackBase;
  union
  {
    struct _KAPC SuspendApc;
    struct
    {
      unsigned char SuspendApcFill0[1];
      char Spare04;
    };
    struct
    {
      unsigned char SuspendApcFill1[3];
      unsigned char QuantumReset;
    };
    struct
    {
      unsigned char SuspendApcFill2[4];
      unsigned long KernelTime;
    };
    struct
    {
      unsigned char SuspendApcFill3[64];
      struct _KPRCB* WaitPrcb;
    };
    struct
    {
      unsigned char SuspendApcFill4[72];
      void* LegoData;
    };
    struct
    {
      unsigned char SuspendApcFill5[83];
      unsigned char PowerState;
      unsigned long UserTime;
    };
  };
  union
  {
    struct _KSEMAPHORE SuspendSemaphore;
    struct
    {
      unsigned char SuspendSemaphorefill[28];
      unsigned long SListFaultCount;
    };
  };
  struct _LIST_ENTRY ThreadListEntry;
  struct _LIST_ENTRY MutantListHead;
  void* SListFaultAddress;
  __int64 ReadOperationCount;
  __int64 WriteOperationCount;
  __int64 OtherOperationCount;
  __int64 ReadTransferCount;
  __int64 WriteTransferCount;
