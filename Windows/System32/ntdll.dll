typedef struct _DISPATCHER_HEADER
{
  union
  {
    volatile long Lock;
    long LockNV;
    struct
    {
      unsigned char Type;
      unsigned char Signalling;
      unsigned char Size;
      unsigned char Reserved1;
    };
    struct
    {
      unsigned char TimerType;
      union
      {
        unsigned char TimerControlFlags;
        struct
        {
          struct /* bitfield */
          {
            unsigned char Absolute : 1; /* bit position: 0 */
            unsigned char Wake : 1; /* bit position: 1 */
            unsigned char EncodedTolerableDelay : 6; /* bit position: 2 */
          }; /* bitfield */
          unsigned char Hand;
          union
          {
            unsigned char TimerMiscFlags;
            struct /* bitfield */
            {
              unsigned char Index : 6; /* bit position: 0 */
              unsigned char Inserted : 1; /* bit position: 6 */
              volatile unsigned char Expired : 1; /* bit position: 7 */
            }; /* bitfield */
          };
        };
      };
    };
    struct
    {
      unsigned char Timer2Type;
      union
      {
        unsigned char Timer2Flags;
        struct
        {
          struct /* bitfield */
          {
            unsigned char Timer2Inserted : 1; /* bit position: 0 */
            unsigned char Timer2Expiring : 1; /* bit position: 1 */
            unsigned char Timer2CancelPending : 1; /* bit position: 2 */
            unsigned char Timer2SetPending : 1; /* bit position: 3 */
            unsigned char Timer2Running : 1; /* bit position: 4 */
            unsigned char Timer2Disabled : 1; /* bit position: 5 */
            unsigned char Timer2ReservedFlags : 2; /* bit position: 6 */
          }; /* bitfield */
          unsigned char Timer2ComponentId;
          unsigned char Timer2RelativeId;
        };
      };
    };
    struct
    {
      unsigned char QueueType;
      union
      {
        unsigned char QueueControlFlags;
        struct
        {
          struct /* bitfield */
          {
            unsigned char Abandoned : 1; /* bit position: 0 */
            unsigned char DisableIncrement : 1; /* bit position: 1 */
            unsigned char QueueReservedControlFlags : 6; /* bit position: 2 */
          }; /* bitfield */
          unsigned char QueueSize;
          unsigned char QueueReserved;
        };
      };
    };
    struct
    {
      unsigned char ThreadType;
      unsigned char ThreadReserved;
      union
      {
        unsigned char ThreadControlFlags;
        struct
        {
          struct /* bitfield */
          {
